#===============================================================================
# Makefile for RISC-V SoC Simulation (VCS + Verdi)
# Engineer: Wang Jianghao
#
# Usage:
#   --- Single Test ---
#   make sim_isa    test=add          # ISA test: searches rv32ui/rv32um for rv32u{i,m}-p-<test>.data
#   make sim_comp   test=I-ADD-01     # Compliance test: searches rv32i/rv32im/... for <test>.data
#
#   --- Batch Tests ---
#   make sim_all_isa   group=rv32ui              # Run all ISA tests under rv32ui
#   make sim_all_comp  group=rv32i                # Run all compliance tests under rv32i
#
#   --- Low-level Targets (manual flow) ---
#   make filelist                  # Generate filelist.f
#   make com_fsdb                  # Compile with FSDB dump
#   make sim                       # Run simulation
#   make verdi                     # Open Verdi
#   make clean                     # Clean artifacts
#===============================================================================

#---------------------------------------------------------------
# Configuration
#---------------------------------------------------------------
CORE_VERSION ?= 00_rv32i_basic

# Directories (relative to sim/)
RTL_DIR     = ../$(CORE_VERSION)/de
DV_DIR      = ../$(CORE_VERSION)/dv
TB_FILE     = $(DV_DIR)/tb_soctop_isatest.sv
TESTS_DIR   = ../tests
ISA_DIR     = $(TESTS_DIR)/rv_tests_isa
COMP_DIR    = $(TESTS_DIR)/rv_compilance

# ISA test search order (used when test= is just a name like "add")
ISA_GROUPS  = rv32ui rv32um
# Compliance test search order
COMP_GROUPS = rv32i rv32im rv32Zicsr rv32Zifencei

# Simulation
SIM_TIMEOUT = 20
SIMV        = ./simv

#---------------------------------------------------------------
# Shared: Generate filelist.f
#   Usage: make filelist MODE=RVTEST_ISA  or  MODE=RVTEST_COMPLIANCE
#---------------------------------------------------------------
MODE ?= RVTEST_ISA

filelist:
	@echo "--- Generating filelist.f (MODE=$(MODE)) ---"
	@find $(RTL_DIR) $(DV_DIR) -name "*.v" -o -name "*.sv" > filelist.f
	@echo "+define+$(MODE)" >> filelist.f

#---------------------------------------------------------------
# Compile (VCS + Verdi/FSDB)
#---------------------------------------------------------------
com: filelist
	vcs -f filelist.f \
		-timescale=1ns/100ps \
		-full64 +v2k -sverilog -Mupdate +define+DUMP_FSDB \
		-debug_acc+all -debug_region+cell+encrypt \
		|tee vcs.log

#---------------------------------------------------------------
# Run Simulation (generic)
#---------------------------------------------------------------
sim:
	$(SIMV) |tee sim.log

#---------------------------------------------------------------
# Waveform Viewer (Verdi)
#---------------------------------------------------------------
verdi:
	verdi -f filelist.f -ssf tb_top.fsdb -play ./scripts/verdi.tcl &

#---------------------------------------------------------------
# ============================================================
#   ISA Single Test:  make sim_isa test=add
# ============================================================
#---------------------------------------------------------------
# Locates the .data file by searching ISA_GROUPS directories.
# File naming convention: <group>-p-<test>.data
#   e.g. test=add  =>  rv32ui/rv32ui-p-add.data
#---------------------------------------------------------------

# Helper function: find ISA data file (returns first match)
# $(1) = test name
define find_isa_data
$(firstword $(wildcard $(foreach g,$(ISA_GROUPS),$(ISA_DIR)/$(g)/$(g)-p-$(1).data)))
endef

sim_isa:
ifndef test
	$(error "Usage: make sim_isa test=<inst_name>  e.g. make sim_isa test=add")
endif
	$(eval DATA_FILE := $(call find_isa_data,$(test)))
	@if [ -z "$(DATA_FILE)" ]; then \
		echo "Error: Could not find .data for ISA test '$(test)' in groups: $(ISA_GROUPS)"; \
		exit 1; \
	fi
	@echo "==========================================="
	@echo "--- ISA Single Test: $(test) ---"
	@echo "--- Data: $(DATA_FILE) ---"
	@echo "--- RTL:  $(CORE_VERSION) ---"
	@echo "==========================================="
	@cp $(DATA_FILE) ./inst.data
	@$(MAKE) --no-print-directory filelist MODE=RVTEST_ISA
	@$(MAKE) --no-print-directory com
	@$(SIMV) |tee sim.log
	@echo ""
	@if grep -q '\[PASS\]' sim.log; then \
		echo ">>> Result: [PASS]"; \
	else \
		echo ">>> Result: [FAIL] — Check sim.log for details"; \
	fi

#---------------------------------------------------------------
# ============================================================
#   Compliance Single Test:  make sim_comp test=I-ADD-01
# ============================================================
#---------------------------------------------------------------
# Locates the .data file by searching COMP_GROUPS directories.
# File naming convention: <test>.data
#   e.g. test=I-ADD-01  =>  rv32i/I-ADD-01.data
#        test=DIV       =>  rv32im/DIV.data
#---------------------------------------------------------------

# Helper function: find Compliance data file
define find_comp_data
$(firstword $(wildcard $(foreach g,$(COMP_GROUPS),$(COMP_DIR)/$(g)/$(1).data)))
endef

# Helper function: derive .ref file from .data file
define get_ref_file
$(patsubst %.data,%.ref,$(1))
endef

sim_comp:
ifndef test
	$(error "Usage: make sim_comp test=<test_name>  e.g. make sim_comp test=I-ADD-01")
endif
	$(eval DATA_FILE := $(call find_comp_data,$(test)))
	@if [ -z "$(DATA_FILE)" ]; then \
		echo "Error: Could not find .data for compliance test '$(test)' in groups: $(COMP_GROUPS)"; \
		exit 1; \
	fi
	$(eval REF_FILE := $(call get_ref_file,$(DATA_FILE)))
	@echo "==========================================="
	@echo "--- Compliance Single Test: $(test) ---"
	@echo "--- Data: $(DATA_FILE) ---"
	@echo "--- Ref:  $(REF_FILE) ---"
	@echo "--- RTL:  $(CORE_VERSION) ---"
	@echo "==========================================="
	@cp $(DATA_FILE) ./inst.data
	@$(MAKE) --no-print-directory filelist MODE=RVTEST_COMPLIANCE
	@$(MAKE) --no-print-directory com
	@if [ -f "$(REF_FILE)" ]; then \
		$(SIMV) +REF_FILE=$(REF_FILE) |tee sim.log; \
	else \
		echo "Warning: Reference file $(REF_FILE) not found, running without comparison."; \
		$(SIMV) |tee sim.log; \
	fi
	@echo ""
	@if grep -q '\[PASS\]' sim.log; then \
		echo ">>> Result: [PASS]"; \
	elif grep -q '\[FAIL\]' sim.log; then \
		echo ">>> Result: [FAIL] — Check sim.log for details"; \
	else \
		echo ">>> Result: [UNKNOWN] — No ref file or no PASS/FAIL marker found"; \
	fi

#---------------------------------------------------------------
# ============================================================
#   Batch ISA Tests:  make sim_all_isa group=rv32ui
# ============================================================
#---------------------------------------------------------------

sim_all_isa:
ifndef group
	$(error "Usage: make sim_all_isa group=<group>  e.g. make sim_all_isa group=rv32ui")
endif
	@echo "==========================================="
	@echo "--- Batch ISA Tests: group=$(group) ---"
	@echo "--- RTL: $(CORE_VERSION) ---"
	@echo "==========================================="
	@total=0; pass=0; fail=0; \
	for data_file in $(ISA_DIR)/$(group)/$(group)-p-*.data; do \
		if [ ! -f "$$data_file" ]; then \
			echo "No .data files found in $(ISA_DIR)/$(group)/"; \
			exit 1; \
		fi; \
		test_name=$$(basename $$data_file .data); \
		total=$$((total + 1)); \
		cp $$data_file ./inst.data; \
		$(MAKE) --no-print-directory filelist MODE=RVTEST_ISA > /dev/null 2>&1; \
		$(MAKE) --no-print-directory com_fsdb > /dev/null 2>&1; \
		$(SIMV) > sim.log 2>&1; \
		if grep -q '\[PASS\]' sim.log; then \
			printf "%-40s [  PASS  ]\n" "$$test_name"; \
			pass=$$((pass + 1)); \
		else \
			printf "%-40s [# FAIL #]\n" "$$test_name"; \
			fail=$$((fail + 1)); \
		fi; \
	done; \
	echo ""; \
	echo "==========================================="; \
	echo "ISA Test Summary: $$pass/$$total Passed"; \
	echo "==========================================="; \
	if [ $$fail -eq 0 ]; then \
		echo "Congratulations, All PASS!"; \
	else \
		echo "Done. $$fail tests failed."; \
		exit 1; \
	fi

#---------------------------------------------------------------
# ============================================================
#   Batch Compliance Tests:  make sim_all_comp group=rv32i
# ============================================================
#---------------------------------------------------------------

sim_all_comp:
ifndef group
	$(error "Usage: make sim_all_comp group=<group>  e.g. make sim_all_comp group=rv32i")
endif
	@echo "==========================================="
	@echo "--- Batch Compliance Tests: group=$(group) ---"
	@echo "--- RTL: $(CORE_VERSION) ---"
	@echo "==========================================="
	@total=0; pass=0; fail=0; \
	for data_file in $(COMP_DIR)/$(group)/*.data; do \
		if [ ! -f "$$data_file" ]; then \
			echo "No .data files found in $(COMP_DIR)/$(group)/"; \
			exit 1; \
		fi; \
		test_name=$$(basename $$data_file .data); \
		ref_file=$${data_file%.data}.ref; \
		total=$$((total + 1)); \
		cp $$data_file ./inst.data; \
		$(MAKE) --no-print-directory filelist MODE=RVTEST_COMPLIANCE > /dev/null 2>&1; \
		$(MAKE) --no-print-directory com_fsdb > /dev/null 2>&1; \
		if [ -f "$$ref_file" ]; then \
			$(SIMV) +REF_FILE=$$ref_file > sim.log 2>&1; \
		else \
			$(SIMV) > sim.log 2>&1; \
		fi; \
		if grep -q '\[PASS\]' sim.log; then \
			printf "%-40s [  PASS  ]\n" "$$test_name"; \
			pass=$$((pass + 1)); \
		else \
			printf "%-40s [# FAIL #]\n" "$$test_name"; \
			fail=$$((fail + 1)); \
		fi; \
	done; \
	echo ""; \
	echo "==========================================="; \
	echo "Compliance Test Summary: $$pass/$$total Passed"; \
	echo "==========================================="; \
	if [ $$fail -eq 0 ]; then \
		echo "Congratulations, All PASS!"; \
	else \
		echo "Done. $$fail tests failed."; \
		exit 1; \
	fi

#---------------------------------------------------------------
# Clean
#---------------------------------------------------------------
clean:
	rm -rf csrc novas* *.log simv* *fsdb* ucli.key verdiLog
	rm -f inst.data signature.output filelist.f

#---------------------------------------------------------------
# Default
#---------------------------------------------------------------
all: filelist com sim verdi

.PHONY: all filelist com sim verdi clean \
        sim_isa sim_comp sim_all_isa sim_all_comp
